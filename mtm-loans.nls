;; reports principal outstanding on a loan of given
;; principal ($), interest rate (%), loan term (years) and
;; maturaity, i.e. years into paying off loan
to-report get-principal-remaining [P i-rate loan-term m]
  if m = nobody [ report 0 ]
  if i-rate = 0 [ report round (P * (loan-term - m) / loan-term) ]
  let r i-rate / 100
  let r-plus-1 r + 1
  let X r-plus-1 ^ m
  let Y r-plus-1 ^ loan-term
  report P * (X - Y * (X - 1) / (Y - 1))
end
